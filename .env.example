# Copie para .env e preencha. Nunca commite valores reais.
# Na Vercel, cadastre as mesmas variáveis em Settings › Environment Variables.

# Supabase (Project Settings › API e Database)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Só no servidor: ignora o RLS.
SUPABASE_SERVICE_ROLE_KEY=
# Token pessoal do Supabase CLI (migrations e configuração do projeto).
SUPABASE_ACCESS_TOKEN=
# Conexão direta com o Postgres (supabase db push --db-url).
SUPABASE_DB_URL=

# Secullum Ponto Web: use um usuário dedicado à integração, não o login do RH.
SECULLUM_USUARIO=
SECULLUM_SENHA=
# Id do banco do Ponto Web (listarBancos). Base da ARP: 64005.
SECULLUM_BANCO_ID=

# WPS ParkingPlus, API BI. Homologação: https://demonstracao.parkingplus.com.br
WPS_BASE_URL=
WPS_USUARIO=
WPS_SENHA=
WPS_ESTACIONAMENTO_ID=

# Copiloto RH, API pública: credencial criada em Configurações › Integrações ›
# API pública (usuário = client_id, senha = client_secret).
COPILOTO_RH_BASE_URL=
COPILOTO_RH_USUARIO=
COPILOTO_RH_SENHA=

# Endereço do sistema, usado nos links enviados pelo WhatsApp (portal do
# lojista, link da OS do terceirizado). Na Vercel, sem ele vale o domínio de
# produção do projeto.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Protege as rotas /api/sync/* e /api/cron/* (o Vercel Cron envia "Authorization: Bearer <valor>").
CRON_SECRET=

# Assina o prazo da sessão (8h no máximo, 30 min parada). Sem ela ninguém entra.
# Gerar: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Trocar a chave encerra todas as sessões abertas.
SESSAO_CHAVE=

# Protótipo do RH: todo salário da folha é gravado como R$ 2.000,00.
# Só mude para false quando a ARP liberar o uso de salários reais.
FOLHA_SALARIO_FICTICIO=true

# Cifra senhas e tokens das integrações salvos na tela (32 bytes em base64).
# Gerar: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Trocar a chave invalida as credenciais salvas (é só cadastrar de novo).
INTEGRACOES_CHAVE=
