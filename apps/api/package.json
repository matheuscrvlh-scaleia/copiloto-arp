{
  "name": "@arp/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrar": "tsx --env-file=.env src/migrar.ts",
    "db:marcar-base": "tsx --env-file=.env src/migrar.ts --marcar-base",
    "db:tipos": "kysely-codegen"
  },
  "dependencies": {
    "@arp/shared": "^1.0.0",
    "@fastify/cookie": "^11.1.5",
    "@fastify/helmet": "^13.2.0",
    "@fastify/multipart": "^10.1.9",
    "@fastify/rate-limit": "^11.2.2",
    "@node-rs/argon2": "^2.2.2",
    "bcryptjs": "^3.0.3",
    "croner": "^11.0.1",
    "docx": "^9.15.3",
    "exceljs": "^4.4.0",
    "fastify": "^5.12.8",
    "fastify-plugin": "^6.0.1",
    "fastify-type-provider-zod": "^7.0.0",
    "jose": "^6.2.17",
    "kysely": "^0.29.9",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "qrcode": "^1.5.4",
    "read-excel-file": "^9.3.10",
    "unpdf": "^1.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "kysely-codegen": "^0.20.0",
    "pino-pretty": "^13.2.0",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15"
  }
}
