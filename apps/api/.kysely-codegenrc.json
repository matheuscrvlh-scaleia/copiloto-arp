{
  "dialect": "postgres",
  "envFile": ".env",
  "url": "env(DATABASE_ADMIN_URL)",
  "outFile": "src/infra/banco/tipos.ts",
  "includePattern": "{core,rh,financeiro,integracao,os,marketing,comercial,formularios,calendario,operacoes,sustentabilidade,auth}.*",
  "dateParser": "string",
  "numericParser": "number",
  "typeMapping": {
    "timestamptz": "string",
    "timestamp": "string",
    "int8": "number"
  }
}
