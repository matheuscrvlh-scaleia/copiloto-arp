{
  "name": "copiloto-arp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev -w @arp/api",
    "dev:web": "npm run dev -w @arp/web",
    "build": "npm run build -w @arp/api && npm run build -w @arp/web",
    "lint": "biome check",
    "format": "biome format --write",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "check": "biome check && npm run typecheck",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.2",
    "typescript": "^5.9.0",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=24"
  }
}
